{
  "schema_version": "1.0",
  "mode": "gui_native",
  "observation_channels": ["screenshot", "screen_recording", "audio_playback"],
  "action_channels": ["pointer_keyboard"],
  "forbidden_channels": [
    "ui_transcript",
    "dom",
    "accessibility_tree",
    "media_element",
    "javascript",
    "local_file",
    "document",
    "spreadsheet",
    "direct_platform_api"
  ],
  "logging": {
    "screenshots": true,
    "recordings": true,
    "watched_intervals": true,
    "channel_access": true
  }
}

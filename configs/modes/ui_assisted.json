{
  "schema_version": "1.0",
  "mode": "ui_assisted",
  "observation_channels": [
    "screenshot",
    "screen_recording",
    "audio_playback",
    "ui_transcript",
    "ui_captions",
    "ui_chapters",
    "ui_description",
    "ui_comments",
    "platform_search"
  ],
  "action_channels": ["pointer_keyboard"],
  "forbidden_channels": [
    "dom",
    "accessibility_tree",
    "media_element",
    "javascript",
    "local_file",
    "document",
    "spreadsheet",
    "direct_platform_api"
  ],
  "logging": {
    "screenshots": true,
    "recordings": true,
    "watched_intervals": true,
    "channel_access": true
  }
}

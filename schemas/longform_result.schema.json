{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/tubebench/longform-result-v1.schema.json",
  "title": "CodexTubeBench long-form result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "task_revision",
    "benchmark_git_revision",
    "environment_stability",
    "environment_mode",
    "exact_success",
    "grounded_success",
    "disturbance_free_success",
    "partial_completion",
    "steps",
    "temporal",
    "verification_score",
    "side_effects",
    "state_tracking_score",
    "channel_selection_score",
    "latency",
    "cost"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string"},
    "task_id": {"type": "string", "pattern": "^LF-[0-9]{3}$"},
    "task_revision": {"type": "integer", "minimum": 1},
    "benchmark_git_revision": {"type": "string", "minLength": 1},
    "environment_stability": {"enum": ["verified", "live"]},
    "environment_mode": {
      "enum": [
        "gui_native",
        "ui_assisted",
        "instrumented_browser",
        "hybrid_enterprise"
      ]
    },
    "exact_success": {"type": "boolean"},
    "grounded_success": {"type": "boolean"},
    "disturbance_free_success": {"type": "boolean"},
    "partial_completion": {"type": "number", "minimum": 0, "maximum": 1},
    "steps": {
      "type": "object",
      "required": ["ui_actions", "observation_requests", "tool_calls", "recovery", "verification"],
      "properties": {
        "ui_actions": {"type": "integer", "minimum": 0},
        "observation_requests": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "recovery": {"type": "integer", "minimum": 0},
        "verification": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "temporal": {
      "type": "object",
      "required": [
        "available_media_seconds",
        "watched_seconds",
        "relevant_seconds",
        "relevant_watched_seconds",
        "watch_ratio",
        "relevant_watch_ratio",
        "evidence_coverage",
        "over_observation_score",
        "under_observation_score"
      ],
      "properties": {
        "available_media_seconds": {"type": "number", "minimum": 0},
        "watched_seconds": {"type": "number", "minimum": 0},
        "relevant_seconds": {"type": "number", "minimum": 0},
        "relevant_watched_seconds": {"type": "number", "minimum": 0},
        "watch_ratio": {"type": ["number", "null"], "minimum": 0},
        "relevant_watch_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "evidence_coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "over_observation_score": {"type": "number", "minimum": 0, "maximum": 1},
        "under_observation_score": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "timestamp_localization_error_seconds": {"type": ["number", "null"], "minimum": 0},
    "weighted_efficiency": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "verification_score": {"type": "number", "minimum": 0, "maximum": 1},
    "side_effects": {
      "type": "object",
      "required": ["disturbance_free", "critical", "incident_count", "severity_points"],
      "properties": {
        "disturbance_free": {"type": "boolean"},
        "critical": {"type": "boolean"},
        "incident_count": {"type": "integer", "minimum": 0},
        "severity_points": {"type": "number", "minimum": 0},
        "incidents": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "state_tracking_score": {"type": "number", "minimum": 0, "maximum": 1},
    "channel_selection_score": {"type": "number", "minimum": 0, "maximum": 1},
    "latency": {
      "type": "object",
      "required": ["wall_clock_seconds", "active_agent_seconds", "playback_wall_seconds"],
      "properties": {
        "wall_clock_seconds": {"type": "number", "minimum": 0},
        "active_agent_seconds": {"type": "number", "minimum": 0},
        "playback_wall_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "cost": {
      "type": "object",
      "required": ["model_calls", "input_tokens", "output_tokens", "usd"],
      "properties": {
        "model_calls": {"type": ["integer", "null"], "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "usd": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tubebench/live_public_video_trace_v0.2.schema.json",
  "title": "TubeBench retained live public video trace v0.2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_id",
    "campaign_id",
    "attempt_id",
    "seed",
    "task_id",
    "task_revision",
    "track",
    "site",
    "task_family",
    "mode",
    "agent",
    "url",
    "started_at",
    "ended_at",
    "benchmark_git_revision",
    "benchmark_git_dirty",
    "lab_git_revision",
    "lab_git_dirty",
    "manifest_digest",
    "config_digest",
    "catalog_digest",
    "prompt_digest",
    "runtime",
    "availability",
    "observations",
    "screenshots",
    "page_refs",
    "browser_tool_calls",
    "actions",
    "watched_intervals",
    "criteria_results",
    "final_answer",
    "final_verification",
    "failures",
    "recovery_attempts",
    "side_effects",
    "metrics",
    "outcome",
    "errors",
    "qualitative_notes"
  ],
  "properties": {
    "schema_version": {"const": "live-public-video-trace.v0.2"},
    "campaign_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "attempt_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "task_id": {"type": "string", "pattern": "^LPV-[0-9]{3}$"},
    "track": {"const": "live_public_video_v0"},
    "mode": {"enum": ["gui_native", "ui_assisted", "instrumented_browser"]},
    "benchmark_git_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "benchmark_git_dirty": {"const": false},
    "lab_git_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "lab_git_dirty": {"const": false},
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "catalog_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codex_identifier",
        "browser_name",
        "browser_version",
        "viewport_width",
        "viewport_height"
      ],
      "properties": {
        "codex_identifier": {"type": "string", "minLength": 1},
        "browser_name": {"type": "string", "minLength": 1},
        "browser_version": {"type": "string", "minLength": 1},
        "viewport_width": {"type": "integer", "minimum": 1},
        "viewport_height": {"type": "integer", "minimum": 1}
      }
    },
    "availability": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["available", "volatile", "blocked", "unavailable"]}
      }
    },
    "observations": {"type": "array", "items": {"type": "object"}},
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["screenshot_id", "path", "description"],
        "properties": {
          "screenshot_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "browser_tool_calls": {"type": "array", "items": {"type": "object"}},
    "actions": {"type": "array", "items": {"type": "object"}},
    "criteria_results": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "failures": {"type": "array", "items": {"type": "object"}},
    "outcome": {
      "type": "object",
      "required": [
        "status",
        "retained_slot",
        "criterion_score",
        "required_criteria_passed",
        "unsupported_claim_count"
      ],
      "properties": {
        "status": {"enum": ["completed", "partial", "failed", "blocked", "invalid"]},
        "retained_slot": {"const": true},
        "criterion_score": {"type": "number", "minimum": 0, "maximum": 1},
        "required_criteria_passed": {"type": "boolean"},
        "unsupported_claim_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}

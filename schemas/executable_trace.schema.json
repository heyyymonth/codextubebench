{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/longformmediabench/executable-trace-v0.1.schema.json",
  "title": "TubeControl-Executable-v0 evaluated trace",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "task_revision",
    "mode",
    "agent",
    "benchmark_git_revision",
    "benchmark_git_dirty",
    "started_at",
    "ended_at",
    "observations",
    "screenshots",
    "actions",
    "browser_tool_calls",
    "watched_intervals",
    "transcript_cues_used",
    "chapter_ids_used",
    "dom_player_state_reads",
    "verifications",
    "final_answer",
    "final_oracle_state",
    "side_effects",
    "metrics",
    "passed",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "tubecontrol-executable-trace.v0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^TCE-[0-9]{3}$"},
    "task_revision": {"type": "integer", "minimum": 1},
    "mode": {
      "enum": [
        "gui_native",
        "ui_assisted",
        "instrumented_browser",
        "hybrid"
      ]
    },
    "agent": {"type": "string", "minLength": 1},
    "benchmark_git_revision": {"type": "string", "minLength": 1},
    "benchmark_git_dirty": {"type": ["boolean", "null"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "observations": {"type": "array", "items": {"type": "object"}},
    "screenshots": {"type": "array", "items": {"type": "string"}},
    "actions": {"type": "array", "items": {"type": "object"}},
    "browser_tool_calls": {"type": "array", "items": {"type": "object"}},
    "watched_intervals": {"type": "array", "items": {"type": "object"}},
    "transcript_cues_used": {"type": "array", "items": {"type": "string"}},
    "chapter_ids_used": {"type": "array", "items": {"type": "string"}},
    "dom_player_state_reads": {"type": "array", "items": {"type": "object"}},
    "verifications": {"type": "array", "items": {"type": "string"}},
    "final_answer": {},
    "final_oracle_state": {"type": "object"},
    "side_effects": {"type": "object"},
    "metrics": {"type": "object"},
    "passed": {"type": "boolean"},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

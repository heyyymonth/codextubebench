{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodexTubeBench workflow rubric",
  "type": "object",
  "required": ["schema_version", "rubric_id", "criteria"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "rubric_id": {"type": "string"},
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "weight", "evidence", "levels"],
        "properties": {
          "id": {"type": "string"},
          "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "gate": {"type": "boolean"},
          "evidence": {"type": "string"},
          "levels": {"type": "object"}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/longformmediabench/executable-result-v0.1.schema.json",
  "title": "TubeControl-Executable-v0 result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "task_revision",
    "mode",
    "agent",
    "benchmark_git_revision",
    "benchmark_git_dirty",
    "passed",
    "metrics",
    "side_effects",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "tubecontrol-executable-result.v0.1"},
    "run_id": {"type": "string"},
    "task_id": {"type": "string", "pattern": "^TCE-[0-9]{3}$"},
    "task_revision": {"type": "integer", "minimum": 1},
    "mode": {"type": "string"},
    "agent": {"type": "string"},
    "benchmark_git_revision": {"type": "string"},
    "benchmark_git_dirty": {"type": ["boolean", "null"]},
    "passed": {"type": "boolean"},
    "metrics": {"type": "object"},
    "side_effects": {"type": "object"},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

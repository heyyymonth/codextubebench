{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodexTubeBench run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "started_at",
    "finished_at",
    "benchmark_version",
    "benchmark_git_revision",
    "catalog_digest",
    "agent",
    "seed",
    "task_count"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark_git_revision": {"type": "string", "minLength": 1},
    "benchmark_git_dirty": {"type": ["boolean", "null"]},
    "catalog_digest": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/longformmediabench/live-youtube-trace-v0.1.schema.json",
  "title": "TubeBench private live YouTube trace v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "task_revision",
    "track",
    "category",
    "mode",
    "agent",
    "url",
    "started_at",
    "ended_at",
    "benchmark_git_revision",
    "benchmark_git_dirty",
    "availability",
    "initial_tabs",
    "initial_media_state",
    "observations",
    "screenshots",
    "actions",
    "browser_tool_calls",
    "channels_used",
    "watched_intervals",
    "final_answer",
    "final_tabs",
    "final_media_state",
    "verifications",
    "side_effects",
    "metrics",
    "passed",
    "failure_type",
    "errors",
    "qualitative_notes"
  ],
  "properties": {
    "schema_version": {"const": "live-youtube-trace.v0.1"},
    "run_id": {"type": "string"},
    "task_id": {"type": "string", "pattern": "^LYT-[0-9]{3}$"},
    "task_revision": {"type": "integer", "minimum": 1},
    "track": {"const": "live_youtube_v0"},
    "category": {"enum": ["long_form", "live_stream", "long_music"]},
    "mode": {"enum": ["gui_native", "ui_assisted", "instrumented_browser"]},
    "agent": {"type": "string"},
    "url": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "benchmark_git_revision": {"type": "string"},
    "benchmark_git_dirty": {"type": ["boolean", "null"]},
    "availability": {"type": "object"},
    "initial_tabs": {"type": "array", "items": {"type": "object"}},
    "initial_media_state": {"type": "object"},
    "observations": {"type": "array", "items": {"type": "object"}},
    "screenshots": {"type": "array", "items": {"type": "string"}},
    "actions": {"type": "array", "items": {"type": "object"}},
    "browser_tool_calls": {"type": "array", "items": {"type": "object"}},
    "channels_used": {"type": "array", "items": {"type": "string"}},
    "watched_intervals": {"type": "array", "items": {"type": "object"}},
    "final_answer": {},
    "final_tabs": {"type": "array", "items": {"type": "object"}},
    "final_media_state": {"type": "object"},
    "verifications": {"type": "array", "items": {"type": "string"}},
    "side_effects": {"type": "object"},
    "metrics": {"type": "object"},
    "passed": {"type": "boolean"},
    "failure_type": {"type": "string"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "qualitative_notes": {"type": "object"}
  },
  "additionalProperties": false
}

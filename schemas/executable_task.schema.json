{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/longformmediabench/executable-task-v0.1.schema.json",
  "title": "TubeControl-Executable-v0 task",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "revision",
    "suite",
    "title",
    "instruction",
    "default_mode",
    "supported_modes",
    "initial_state",
    "media",
    "allowed_action_types",
    "allowed_mutations",
    "forbidden_mutations",
    "success",
    "relevant_spans",
    "human_reference",
    "scripted_run"
  ],
  "properties": {
    "schema_version": {"const": "tubecontrol-executable-task.v0.1"},
    "id": {"type": "string", "pattern": "^TCE-[0-9]{3}$"},
    "revision": {"type": "integer", "minimum": 1},
    "suite": {"const": "TubeControl-Executable-v0"},
    "title": {"type": "string", "minLength": 1},
    "instruction": {"type": "string", "minLength": 1},
    "default_mode": {"$ref": "#/$defs/mode"},
    "supported_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/mode"}
    },
    "initial_state": {"type": "object"},
    "media": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "media_id",
          "title",
          "duration_seconds",
          "transcript",
          "chapters",
          "visual_events"
        ],
        "properties": {
          "media_id": {"type": "string"},
          "title": {"type": "string"},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "transcript": {"type": "array", "items": {"type": "object"}},
          "chapters": {"type": "array", "items": {"type": "object"}},
          "visual_events": {"type": "array", "items": {"type": "object"}}
        },
        "additionalProperties": false
      }
    },
    "allowed_action_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "allowed_mutations": {"type": "array", "items": {"type": "string"}},
    "forbidden_mutations": {"type": "array", "items": {"type": "string"}},
    "success": {
      "type": "object",
      "required": [
        "state_predicates",
        "answer",
        "verification_requirements",
        "accepted_evidence_channels"
      ],
      "properties": {
        "state_predicates": {"type": "array", "items": {"type": "object"}},
        "answer": {"type": ["object", "null"]},
        "verification_requirements": {
          "type": "array",
          "items": {"type": "string"}
        },
        "accepted_evidence_channels": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "relevant_spans": {"type": "array", "items": {"type": "object"}},
    "human_reference": {
      "type": "object",
      "required": ["steps", "watched_seconds"],
      "properties": {
        "steps": {"type": "number", "minimum": 0},
        "watched_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "scripted_run": {"type": "object"},
    "random_actions": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "mode": {
      "enum": [
        "gui_native",
        "ui_assisted",
        "instrumented_browser",
        "hybrid"
      ]
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/tubebench/executable-result-v0.2.schema.json",
  "title": "TubeControl-Executable-v0 granular result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "task_id", "task_revision", "mode", "agent",
    "benchmark_git_revision", "benchmark_git_dirty", "passed", "outcome",
    "dimensions", "step_results", "metrics", "side_effects", "errors"
  ],
  "properties": {
    "schema_version": {"const": "tubecontrol-executable-result.v0.2"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "pattern": "^TCE-[0-9]{3}$"},
    "task_revision": {"type": "integer", "minimum": 1},
    "mode": {"type": "string", "minLength": 1},
    "agent": {"type": "string", "minLength": 1},
    "benchmark_git_revision": {"type": "string", "minLength": 1},
    "benchmark_git_dirty": {"type": ["boolean", "null"]},
    "passed": {"type": "boolean"},
    "outcome": {
      "type": "object",
      "required": ["status", "exact_success", "disturbance_free_success", "task_positive_progress", "critical_incident"],
      "properties": {"status": {"enum": ["completed", "partial", "failed", "blocked", "invalid"]}}
    },
    "dimensions": {"type": "object"},
    "step_results": {"type": "array", "items": {"type": "object"}},
    "metrics": {"type": "object"},
    "side_effects": {"type": "object"},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
